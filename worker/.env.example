# Copy to worker/.env and fill in values. Full walkthrough: docs/SETUP.md
# The worker refuses to start and lists every missing variable, so a
# half-filled file fails loudly rather than mid-job.

# ── Supabase — database (same values as web/.env.local) ───────────────────────
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ── Storage — Cloudflare R2 (same values as web/.env.local) ──────────────────
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_REGION=auto
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=clippy
R2_PUBLIC_DOMAIN=              # optional, must match web

# ── AI APIs ───────────────────────────────────────────────────────────────────
REPLICATE_API_TOKEN=r8_...     # https://replicate.com/account/api-tokens — WhisperX transcription

# ── Worker ────────────────────────────────────────────────────────────────────
WORKER_SECRET=                 # must equal WORKER_SECRET in web/.env.local

# ── Optional ──────────────────────────────────────────────────────────────────
HUGGINGFACE_TOKEN=             # speaker diarization only (free; accept pyannote's model terms)
JOB_POLL_INTERVAL=10           # seconds between recovery polls; 0 disables the loop
EXPORT_CONCURRENCY=2           # simultaneous ffmpeg export renders
DAILY_CLEANUP_ENABLED=false    # true wipes all videos/clips/exports at midnight UTC
YT_COOKIES_B64=                # base64 cookies.txt for age/region-restricted YouTube sources
YT_PROXY=                      # e.g. http://user:pass@host:port

# LLM routing — one model per pipeline stage, each with a fallback (_FB) tried
# when the primary errors. Defaults shown; any OpenRouter model id works.
# LLM_MODEL_HOOK=openai/gpt-5.5                     LLM_MODEL_HOOK_FB=anthropic/claude-opus-4-7
# LLM_MODEL_RANKER=openai/gpt-5.5                   LLM_MODEL_RANKER_FB=anthropic/claude-opus-4-7
# LLM_MODEL_TENSION=openai/gpt-5.5                  LLM_MODEL_TENSION_FB=anthropic/claude-opus-4-6
