# Copy to worker/.env and fill in values. Full walkthrough: docs/SETUP.md
# The worker refuses to start and lists every missing variable, so a
# half-filled file fails loudly rather than mid-job.

# ── Supabase — database (same values as web/.env.local) ───────────────────────
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ── Storage — Cloudflare R2 (same values as web/.env.local) ──────────────────
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_REGION=auto
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=clippy
R2_PUBLIC_DOMAIN=              # optional, must match web

# ── Worker ────────────────────────────────────────────────────────────────────
WORKER_SECRET=                 # must equal WORKER_SECRET in web/.env.local

# ── Optional ──────────────────────────────────────────────────────────────────
HF_TOKEN=                      # local pyannote speaker diarization
JOB_POLL_INTERVAL=10           # seconds between recovery polls; 0 disables the loop
EXPORT_CONCURRENCY=2           # simultaneous ffmpeg export renders
DAILY_CLEANUP_ENABLED=false    # true wipes all videos/clips/exports at midnight UTC
YT_COOKIES_FROM_BROWSER=safari # local Mac browser cookies for YouTube
YT_COOKIES_B64=                # optional base64 cookies.txt fallback
YT_PROXY=                      # e.g. http://user:pass@host:port

# Local LLM: Ollama must be running at http://127.0.0.1:11434
# Default model used by the pipeline: qwen3:4b
