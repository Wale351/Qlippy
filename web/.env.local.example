# Copy to web/.env.local and fill in values. Full walkthrough: docs/SETUP.md
#
# Four accounts are needed: Supabase and Cloudflare R2 (free), OpenRouter and
# Replicate (pay per use, only when you process a video). Nothing is metered by the app itself.

# ── Auth ──────────────────────────────────────────────────────────────────────
# "local" runs the app as a single fixed user — no accounts, no sign-in, no
# Clerk keys. This is the setting for running Clippy on your own machine.
# Delete the line to enable multi-user Clerk auth for a hosted deployment.
NEXT_PUBLIC_AUTH_MODE=local

# Only when NEXT_PUBLIC_AUTH_MODE is NOT "local" — https://dashboard.clerk.com
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SECRET_KEY=sk_test_...
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/library
# NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/library

# ── Supabase — database ───────────────────────────────────────────────────────
# Project Settings → API. Use the service_role key (server-side only).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ── Storage — Cloudflare R2 (any S3-compatible bucket also works) ─────────────
# dash.cloudflare.com → R2 → create bucket "clippy" → Manage R2 API Tokens →
# Object Read & Write. Supabase's own storage caps files at 50 MB on the free
# plan, which is too small for source videos. (The R2_ prefix is historical.)
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_REGION=auto
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=clippy
R2_PUBLIC_DOMAIN=              # optional: a custom domain connected to the bucket

# ── OpenRouter — LLM for clip identification and social copy ─────────────────

# ── Worker ────────────────────────────────────────────────────────────────────
WORKER_URL=http://127.0.0.1:8000
# Shared secret for Next.js → worker calls. Must equal WORKER_SECRET in
# worker/.env. Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
WORKER_SECRET=
